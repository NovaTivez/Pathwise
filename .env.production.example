# Copy to .env.production for Docker only. Never overwrite the existing .env with server keys.
# For Render, enter these values in its Environment dashboard, not a repository file.
NODE_ENV=production
PUBLIC_URL=https://replace-with-actual-public-host.invalid
# WEB_ORIGIN is optional; if set it must exactly match PUBLIC_URL (no trailing slash).
DATABASE_PATH=/var/data/pathwise.sqlite
PERSISTENT_DATA_DIR=/var/data
STORAGE_KIND=docker-volume
AGENT_INSTANCES=1
PORT=10000
# Leave false until the real webhook/credentials/owner setup is ready. Only Testnet is supported.
PAYMENTS_ENABLED=false
NOIR_DEVICE_REGISTRY=CAC4KOLHDLDYDWBOKXNKRN5KVHO56PLOIFXDLTBUWGVN6GVDEB7FQHU5
NOIR_AGENT_REGISTRY=CCMZDSPTLX7IIJWCYEUM5DJUHOSOYSTHGK777S2TXZWEMC5ZZGPJ3EBV
NOIR_PAYMENT_ESCROW=CC7EAW5FNJEDBS7THM5IT6XIOHO4AOYMLXT3KSZ3HWUIKEACTW7E5BFS
# Copy these existing server-only Testnet values from local .env using your editor.
NOIR_AGENT_SECRET=
NOIR_PROVIDER_SECRET=
NOIR_PROVIDER_2_SECRET=
NOIR_PROVIDER_3_SECRET=
VELO_API_KEY=
VELO_PROJECT_ID=
VELO_WEBHOOK_SECRET=
VELO_SERVICE_AMOUNT=1
