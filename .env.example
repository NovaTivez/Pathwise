# Root .env is read by npm run dev, server, and migrate. Never commit it.
PORT=3001
WEB_ORIGIN=http://localhost:5173
# All environments default to paused. Opt in only after Testnet setup is verified.
PAYMENTS_ENABLED=false
# DATABASE_PATH=C:/absolute/path/to/pathwise.sqlite
# Defaults match the user-transcribed Nov 5 handbook and Noir SDK 0.3.0.
# These are public Testnet contract addresses, not credentials.
NOIR_DEVICE_REGISTRY=CAC4KOLHDLDYDWBOKXNKRN5KVHO56PLOIFXDLTBUWGVN6GVDEB7FQHU5
NOIR_AGENT_REGISTRY=CCMZDSPTLX7IIJWCYEUM5DJUHOSOYSTHGK777S2TXZWEMC5ZZGPJ3EBV
NOIR_PAYMENT_ESCROW=CC7EAW5FNJEDBS7THM5IT6XIOHO4AOYMLXT3KSZ3HWUIKEACTW7E5BFS
# Optional provenance note; it never permits different contract IDs.
NOIR_APPROVAL_REFERENCE=
# Server-only dedicated Testnet keys. npm run setup:testnet fills these safely.
NOIR_AGENT_SECRET=
NOIR_PROVIDER_SECRET=
# Obtain a Testnet checkout API key and project ID from the Velo project console.
VELO_API_KEY=
VELO_PROJECT_ID=
# Copy the signing secret for your configured webhook endpoint.
VELO_WEBHOOK_SECRET=
# Fixed server-controlled service fee in native Testnet XLM, separate from escrow.
VELO_SERVICE_AMOUNT=1
# Velo origin, native asset, and Testnet network are fixed in code for this experiment.
# Webhook URL: https://YOUR-TUNNEL/api/webhooks/velo
# If PORT changes, also update apps/web/vite.config.ts.

# Phase 3: Sandbox Grove and Exam Lantern dedicated server-only Testnet keys.
NOIR_PROVIDER_2_SECRET=
NOIR_PROVIDER_3_SECRET=
